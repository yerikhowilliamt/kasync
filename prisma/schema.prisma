// schema.prisma
// Cash Flow Reconciliation & Allocation Tool
// See ERD-cashflow-reconciliation.md for design rationale and constraint notes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  BANK
  CASH
  EWALLET
}

enum TransactionType {
  INFLOW
  OUTFLOW
}

enum TransactionStatus {
  UNRESOLVED // no candidate match found / zero allocation
  PENDING_REVIEW // matching engine proposed candidate, awaiting confirmation
  PARTIALLY_ALLOCATED // sum(allocation) < amount
  MATCHED // sum(allocation) == amount
}

enum AllocationStatus {
  ACTIVE
  REVOKED
}

model Account {
  id          String   @id @default(uuid())
  name        String
  type        AccountType
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions BankTransaction[]

  @@map("accounts")
}

model BankTransaction {
  id          String            @id @default(uuid())
  accountId   String            @map("account_id")
  txnDate     DateTime          @map("txn_date")
  amount      Decimal           @db.Decimal(18, 2)
  type        TransactionType   @default(OUTFLOW)
  description String
  externalRef String?           @map("external_ref") // raw reference/ID from bank statement, for de-duplication
  dedupHash   String?           @map("dedup_hash")
  status      TransactionStatus @default(UNRESOLVED)
  importedAt  DateTime          @default(now()) @map("imported_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  account     Account      @relation(fields: [accountId], references: [id])
  allocations Allocation[]

  // Prevents importing the exact same bank row twice within one account
  @@unique([accountId, externalRef])
  @@unique([accountId, dedupHash])
  @@index([txnDate])
  @@index([status])
  @@map("bank_transactions")
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  ledgerEntries LedgerEntry[]

  @@map("categories")
}

model Branch {
  id   String @id @default(uuid())
  name String @unique

  ledgerEntries LedgerEntry[]

  @@map("branches")
}

model LedgerEntry {
  id         String          @id @default(uuid())
  categoryId String          @map("category_id")
  branchId   String          @map("branch_id")
  entryDate  DateTime        @map("entry_date")
  amount     Decimal         @db.Decimal(18, 2)
  type       TransactionType @default(OUTFLOW)
  note       String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  category    Category     @relation(fields: [categoryId], references: [id])
  branch      Branch       @relation(fields: [branchId], references: [id])
  allocations Allocation[]

  @@index([entryDate])
  @@index([categoryId])
  @@index([branchId])
  @@map("ledger_entries")
}

model Allocation {
  id                String   @id @default(uuid())
  bankTransactionId String   @map("bank_transaction_id")
  ledgerEntryId     String   @map("ledger_entry_id")
  amountPortion     Decimal  @db.Decimal(18, 2) @map("amount_portion")
  status            AllocationStatus @default(ACTIVE)
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime @default(now()) @map("created_at")

  bankTransaction BankTransaction @relation(fields: [bankTransactionId], references: [id])
  ledgerEntry     LedgerEntry     @relation(fields: [ledgerEntryId], references: [id])

  @@index([bankTransactionId])
  @@index([ledgerEntryId])
  @@map("allocations")
}
